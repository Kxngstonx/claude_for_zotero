{
  "name": "zotero-claude-assist",
  "type": "module",
  "version": "0.1.4",
  "description": "Claude & Gemini reading assistant for Zotero (personal use)",
  "config": {
    "addonName": "Zotero Claude Assist",
    "addonID": "zotero-claude-assist@local",
    "addonRef": "claudeassist",
    "addonInstance": "ClaudeAssist",
    "prefsPrefix": "extensions.zotero.claudeassist"
  },
  "author": "Okdol",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "sync-prompts": "node scripts/sync-prompts.mjs",
    "start": "npm run sync-prompts && zotero-plugin serve",
    "build": "npm run sync-prompts && zotero-plugin build && tsc --noEmit",
    "test:unit": "node --test \"test/unit/**/*.test.ts\"",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^6.0.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.3.0",
    "eslint": "^10.15.0",
    "mocha": "^12.0.3",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "zotero-plugin-scaffold": "^0.9.4",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  },
  "overrides": {
    "typescript-eslint": {
      "typescript": "6.0.3"
    }
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kxngstonx/claude_for_zotero.git"
  }
}
